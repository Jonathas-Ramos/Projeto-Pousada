# Configure estas variáveis no ambiente do processo/container. Não há leitura automática deste arquivo.
COLONIA_DB=/data/colonia.sqlite3
COLONIA_HOSTS=localhost,127.0.0.1,seu-dominio.example
# Use 1 em produção com HTTPS; 0 somente para HTTP local.
COLONIA_SECURE_COOKIE=1
# Em outro proxy, defina a origem HTTPS pública se os cabeçalhos de proxy não forem confiáveis.
# No Render, RENDER_EXTERNAL_URL e RENDER_EXTERNAL_HOSTNAME são fornecidas automaticamente.
# COLONIA_PUBLIC_URL=https://seu-dominio.example
# Para permitir "Não tenho cadastro" na demonstração (somente dados fictícios):
# COLONIA_SELF_REGISTER=1
# Sem essa opção, o cadastro público fica bloqueado. Contas existentes ainda podem entrar.
# Fluxo antigo de primeiro acesso, se necessário em instalação fechada:
# COLONIA_SETUP_CODE=
# O fuso operacional é fixado no código; TZ do sistema não é necessário.
